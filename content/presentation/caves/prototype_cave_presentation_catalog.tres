[gd_resource type="Resource" load_steps=9 format=3]

[ext_resource type="Script" path="res://presentation/world/caves/cave_presentation_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://presentation/world/caves/cave_presentation_catalog.gd" id="2_catalog"]

[sub_resource type="Resource" id="Profile_default"]
script = ExtResource("1_profile")
profile_id = "presentation.cave.default"
volume_kind = "*"
priority = -100
albedo_color = Color(0.235, 0.215, 0.19, 1)
roughness = 0.94
ambience_id = "ambience.cave.default"
fog_color = Color(0.11, 0.10, 0.09, 1)
fog_density = 0.035
dressing_hooks = ["dressing.cave.general"]

